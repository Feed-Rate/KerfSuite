# Supabase client configuration.
# Use only the public/anonymous key here. Never place the service-role key in
# a Flutter application because this file is bundled into the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# KerfSuite production Portal. For local development, override with
# http://localhost:3000 or another address the device can reach.
KERFPORTAL_API_URL=https://kerfsuite.vercel.app
