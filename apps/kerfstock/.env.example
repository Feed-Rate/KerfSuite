# Supabase client configuration.
# Use only the public/anonymous key here. Never place the service-role key in
# a Flutter application because this file is bundled into the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Local KerfPortal development server. For Android devices/emulators, replace
# localhost with an address the device can reach.
KERFPORTAL_API_URL=http://localhost:3000
